    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a prioritization agent.\n\nGiven the following assignments:\n\n{{ $json.output }}\n\nRank assignments based on:\n\n1. Earliest deadline\n2. Highest difficulty\n\nReturn ONLY JSON:\n\n{\n  \"priority_order\": [\n    \"Assignment Name\"\n  ],\n  \"reason\": \"Short explanation\"\n}",
        "options": {}
      },
