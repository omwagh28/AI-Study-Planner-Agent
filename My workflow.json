    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a task extraction agent.\n\nAnalyze the following assignments:\n\n{{ $json.assignments }}\n\nExtract:\n1. Assignment Name\n2. Deadline\n3. Difficulty\n\nReturn ONLY valid JSON in this format:\n\n{\n  \"tasks\": [\n    {\n      \"name\": \"\",\n      \"deadline\": \"\",\n      \"difficulty\": \"\"\n    }\n  ]\n}",
        "options": {}
      },
