    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an intelligent study planning agent.\n\nPriority Information:\n\n{{ $('Priority Agent').item.json.output }}\n\nWorkload Analysis:\n\n{{ $json.output }}\n\nAvailable Study Hours:\n\n{{ $('Student Input').item.json.available_hours }}\n\nCreate a personalized study schedule.\n\nRequirements:\n\n1. Allocate more time to higher priority assignments.\n2. Consider workload and stress level.\n3. Provide a clear schedule.\n4. Include one productivity recommendation.\n\nReturn only plain text.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1328,
